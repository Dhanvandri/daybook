{
  "name": "daybook-desktop",
  "version": "2.1.1",
  "private": true,
  "description": "Daybook offline activity calendar and reminders",
  "author": {
    "name": "Daybook"
  },
  "productName": "Daybook",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "electron tests/desktop-smoke.cjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.daybook.calendar",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "index.html"
    ],
    "artifactName": "Daybook-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office",
      "syncDesktopName": true
    }
  },
  "desktopName": "com.daybook.calendar.desktop"
}
